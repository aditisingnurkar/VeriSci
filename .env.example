# VeriSci Configuration
# Optional: Provide your Google Gemini API key to enable generative AI explanations & inquest chat
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: LLM model selection (default: gemini-3.1-flash-lite)
LLM_MODEL=gemini-3.1-flash-lite

# Optional: Provider ("gemini" or "mock")
LLM_PROVIDER=gemini

